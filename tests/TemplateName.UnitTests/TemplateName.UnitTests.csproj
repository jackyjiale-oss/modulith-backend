<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\TemplateName.SharedKernel\TemplateName.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\TemplateName.Application.Common\TemplateName.Application.Common.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\TemplateName.Infrastructure.Common\TemplateName.Infrastructure.Common.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\TemplateName.Web.Common\TemplateName.Web.Common.csproj" />
    <ProjectReference Include="..\..\src\Modules\Auth\TemplateName.Modules.Auth\TemplateName.Modules.Auth.csproj" />
    <ProjectReference Include="..\..\src\Modules\Notifications\TemplateName.Modules.Notifications\TemplateName.Modules.Notifications.csproj" />
    <ProjectReference Include="..\..\src\Modules\Sample\TemplateName.Modules.Sample\TemplateName.Modules.Sample.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenApiSecurityTests call AddOpenApi; the package's build targets enable the interceptors its source generator emits. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Test-only notification templates for TestNotificationTypeSource. The template store expects the names a module gets from a
      root-level Templates folder ({AssemblyName}.Templates.{Channel}.{file}), so the Notifications folder is left out of the name.
    -->
    <EmbeddedResource Include="Notifications\Templates\Email\*.scriban" LogicalName="$(AssemblyName).Templates.Email.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Notifications\Templates\InApp\*.scriban" LogicalName="$(AssemblyName).Templates.InApp.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
