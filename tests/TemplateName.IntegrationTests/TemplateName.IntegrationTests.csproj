<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Host\TemplateName.Api\TemplateName.Api.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\TemplateName.Infrastructure.Common\TemplateName.Infrastructure.Common.csproj" />
    <ProjectReference Include="..\..\src\Modules\Auth\TemplateName.Modules.Auth\TemplateName.Modules.Auth.csproj" />
    <ProjectReference Include="..\..\src\Modules\Auth\TemplateName.Modules.Auth.Contracts\TemplateName.Modules.Auth.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Notifications\TemplateName.Modules.Notifications\TemplateName.Modules.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The templates of DeliveryTestTypeSource, under the names a module's own Templates folder gets. -->
    <EmbeddedResource Include="Notifications\Templates\Email\*.scriban" LogicalName="$(AssemblyName).Templates.Email.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Notifications\Templates\InApp\*.scriban" LogicalName="$(AssemblyName).Templates.InApp.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- One repository-root locator and one document-path derivation for both test projects. -->
    <Compile Include="..\TemplateName.ArchitectureTests\RepositoryPaths.cs" Link="Documentation\RepositoryPaths.cs" />
    <Compile Include="..\TemplateName.ArchitectureTests\DocumentPaths.cs" Link="Documentation\DocumentPaths.cs" />
  </ItemGroup>

</Project>
