<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Modulith.Backend.Templates</PackageId>
    <Authors>Modulith contributors</Authors>
    <Description>ASP.NET Core 10 modular-monolith backend on SQL Server: module boundaries, outbox, idempotency, observability and architecture tests.</Description>
    <PackageTags>dotnet-new;templates;aspnetcore;modular-monolith;sql-server</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/jackyjiale-oss/modulith-backend</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jackyjiale-oss/modulith-backend.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111;CS2008</NoWarn>
    <RepoRoot>$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)../..'))'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE-README.md" Pack="true" PackagePath="/" />
    <Content Include="$(RepoRoot)**/*"
             Exclude="$(RepoRoot).git;$(RepoRoot).git/**;$(RepoRoot)**/bin/**;$(RepoRoot)**/obj/**;$(RepoRoot).vs/**;$(RepoRoot).superpowers/**;$(RepoRoot).claude/**;$(RepoRoot)docs/superpowers/**;$(RepoRoot)artifacts/**;$(RepoRoot)build/pack/**;$(RepoRoot)coverage/**;$(RepoRoot)**/TestResults/**;$(RepoRoot)**/*.user;$(RepoRoot).env"
             Pack="true"
             PackagePath="content/" />
  </ItemGroup>

</Project>
