{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Localization": {
    "DefaultCulture": "en",
    "SupportedUICultures": [ "en", "ms", "zh-Hans" ]
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Auth": {
    "Password": {
      "MinLength": 12,
      "MaxLength": 128,
      "HistoryCount": 5,
      "CheckBreached": true
    },
    "Email": {
      "Host": "localhost",
      "Port": 1025,
      "UseTls": false,
      "Username": "",
      "Password": "",
      "From": "no-reply@localhost.test",
      "FromName": "TemplateName",
      "Timeout": "00:00:30"
    },
    "Links": {
      "ConfirmEmailUrl": "http://localhost:3000/confirm-email?token={token}",
      "ResetPasswordUrl": "http://localhost:3000/reset-password?token={token}"
    },
    "Verification": {
      "EmailLifetime": "01:00:00",
      "PasswordResetLifetime": "00:30:00",
      "ResendCooldown": "00:01:00"
    },
    "RefreshToken": {
      "SlidingLifetime": "14.00:00:00",
      "AbsoluteLifetime": "90.00:00:00"
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Duration": "00:15:00"
    },
    "Jwt": {
      "Issuer": "templatename",
      "Audience": "templatename-api",
      "AccessTokenLifetime": "00:10:00",
      "ClockSkew": "00:00:30",
      "SigningKeys": []
    },
    "Seed": {
      "RunOnStartup": true,
      "AdminEmail": "",
      "AdminPassword": ""
    }
  },
  "Notifications": {
    "Templates": {
      "ProductName": "TemplateName"
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "LeaseDuration": "00:01:00"
  },
  "Idempotency": {
    "TimeToLive": "1.00:00:00",
    "InProgressTimeout": "00:05:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindow": "00:01:00",
    "AuthStrictPermitLimit": 10,
    "AuthStrictWindow": "00:01:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  }
}
