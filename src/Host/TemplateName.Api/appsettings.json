{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Localization": {
    "DefaultCulture": "en",
    "SupportedUICultures": [ "en", "ms", "zh-Hans" ]
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "LeaseDuration": "00:01:00"
  },
  "Idempotency": {
    "TimeToLive": "1.00:00:00",
    "InProgressTimeout": "00:05:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "GlobalWindow": "00:01:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  }
}
